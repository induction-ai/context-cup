#!/bin/bash
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DB="$ROOT/course/db"
if [ $# -eq 0 ]; then
  command=""
else
  command="$1"
  shift
fi

print_usage() {
  echo "Usage: bin/db <command> [options]"
  echo ""
  echo "Commands:"
  echo "  generate    Generate a migration from schema changes"
  echo "  migrate     Apply pending migrations"
  echo "  reset       Drop all tables and re-migrate to a specific point"
  echo "  check       Verify migrations, snapshots, and schema.ts agree"
  echo ""
  echo "Run \`bin/db <command> --help\` for command-specific options."
}

case "$command" in
  ""|-h|--help)
    print_usage
    exit 0
    ;;
  generate)
    cd "$DB" && exec node_modules/.bin/drizzle-kit generate "$@"
    ;;
  migrate)
    cd "$DB" && exec node_modules/.bin/tsx scripts/migrate.ts "$@"
    ;;
  reset)
    cd "$DB" && exec node_modules/.bin/tsx scripts/reset.ts "$@"
    ;;
  check)
    cd "$DB" && exec node_modules/.bin/tsx scripts/check.ts "$@"
    ;;
  *)
    {
      echo "Unknown command: $command"
      echo ""
      print_usage
    } >&2
    exit 1
    ;;
esac

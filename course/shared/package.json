{
  "private": true,
  "name": "@context-cup/shared",
  "version": "0.1.0",
  "description": "Code shared across course packages: env loading and the package-neutral test bootstrap",
  "type": "module",
  "exports": {
    "./*.js": "./src/*.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src --log-level warn",
    "lint": "prettier --check src"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "catalog:",
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "private": true,
  "name": "@context-cup/site",
  "version": "0.1.0",
  "description": "Results site: browse suite runs, jobs, trials, and model calls",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3300",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --port ${SITE_PORT:-3300}",
    "prelaunch": "../../bin/db migrate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@context-cup/db": "workspace:*",
    "@context-cup/shared": "workspace:*",
    "bootstrap": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

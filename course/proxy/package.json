{
  "private": true,
  "name": "@context-cup/proxy",
  "version": "0.1.0",
  "description": "Forwarding proxy that every model call goes through: injects provider keys, relays streams, and records one call per request",
  "type": "module",
  "exports": {
    "./*.js": "./src/*.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "test": "../../bin/test --project proxy",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests --log-level warn",
    "lint": "prettier --check src tests"
  },
  "dependencies": {
    "@context-cup/shared": "workspace:*",
    "express": "catalog:",
    "yargs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/yargs": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

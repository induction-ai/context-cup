# DATABASE_URL (string, required)
# PostgreSQL connection string for the development database
DATABASE_URL=postgresql://localhost:5432/context_cup

# TEST_DATABASE_URL (string, default: postgres://localhost:5432/context_cup_test)
# Base name for the per-worker test databases (context_cup_test_1, _2, ...),
# which the test suite creates on first run.
TEST_DATABASE_URL=postgres://localhost:5432/context_cup_test

# TEST_WORKERS (number, default: CPU count minus one)
# How many worker databases the test suite prepares.
TEST_WORKERS=

# NODE_ENV (enum: development | test | production, default: development)
NODE_ENV=development

# DEBUG (boolean, default: false)
# Verbose SQL logging from drizzle-kit
DEBUG=

# LEAVEDB (boolean, default: false)
# Skip transaction rollback in tests to inspect database state afterwards
LEAVEDB=

# Provider API keys (strings). Held inside each trial by its proxy only, never
# by driver code; OPENAI_API_KEY also runs the tau3 user simulator and verifier.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# SUITE_DOCKER_COUNT (number, default: 2 on arm64, 4 on x86, at most the CPU count)
# Max harbor jobs running at once on local docker.
SUITE_DOCKER_COUNT=

# HARBOR_DIR (string, default: .harbor/repo)
# `global` uses the harbor on PATH; a path uses that checkout; unset clones the fork.
HARBOR_DIR=

# DAYTONA_API_KEY (string)
# Required for `bin/suite --harbor_env daytona` and `bin/daytona_sweep`.
DAYTONA_API_KEY=

# TARGETS_FILE (path, default: targets.json at the repo root)
# The named target models bin/suite --target chooses from.
TARGETS_FILE=

# SITE_URL (url, default: http://localhost:3300)
# Where the results site (course/site) is served; bin/suite prints links into it.
SITE_URL=

# CC_SAVE_BODIES (boolean, default: false)
# Have each trial's proxy keep every model request and response body under
# the trial's agent/bodies/.
CC_SAVE_BODIES=

{
  "private": true,
  "name": "@context-cup/engine-typescript",
  "version": "0.1.0",
  "description": "TypeScript engine: a driver is run(ctx) in driver.ts returning the provider's response; it brings its own SDK, bundled on the host.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*.js": "./src/*.ts"
  },
  "contextCup": {
    "kind": "engine",
    "providers": [
      "openai",
      "anthropic",
      "gemini"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "../../bin/test --project engine-typescript",
    "format": "prettier --write src tests --log-level warn",
    "lint": "prettier --check src tests"
  },
  "dependencies": {
    "@context-cup/protocol": "workspace:*"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "catalog:",
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "private": true,
  "name": "@context-cup-drivers/base_typescript",
  "version": "0.1.0",
  "description": "Clips any tool result larger than max_bytes before it reaches the model. base_python, in TypeScript.",
  "type": "module",
  "contextCup": {
    "kind": "driver",
    "extends": "@context-cup/engine-typescript",
    "providers": [
      "openai",
      "anthropic",
      "gemini"
    ],
    "config": {
      "max_bytes": 100000
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@context-cup/engine-typescript": "workspace:*",
    "openai": "^7.20.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "catalog:",
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}

{
  "private": true,
  "name": "@context-cup-drivers/base_aisdk",
  "version": "0.1.0",
  "description": "Clips any tool result larger than max_bytes before it reaches the model. base_python, on the AI SDK.",
  "type": "module",
  "contextCup": {
    "kind": "driver",
    "extends": "@context-cup/engine-aisdk",
    "providers": [
      "openai",
      "anthropic",
      "gemini"
    ],
    "config": {
      "max_bytes": 100000
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-path ../../.gitignore --log-level warn",
    "lint": "prettier --check . --ignore-path ../../.gitignore"
  },
  "dependencies": {
    "@context-cup/engine-aisdk": "workspace:*"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "catalog:",
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
